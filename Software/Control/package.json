{
  "name": "mad-wasm-control",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend-only MaD tensile-tester control app (Web Serial + WebAssembly). Chromium-only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "app": "vite --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build ../../Protocol/ProtoEmb/runtime --target web --release --out-dir \"$PWD/src/wasm\"",
    "generate:proto": "python3 ../../Protocol/ProtoEmb/core/generate.py --schema ../../Protocol/MaDProtocol.yaml --target ts --output ./src/protocol/generated --templates ../../Protocol/ProtoEmb/core/templates",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "verify": "tsc -b && eslint src && vitest run --config vitest.config.ts && vite build",
    "e2e": "node e2e/run-all.mjs",
    "e2e:smoke": "node e2e/run-smoke.mjs",
    "sil:bridge": "node tools/sil-ws-bridge.mjs",
    "sil:smoke": "node e2e/sil-smoke.mjs",
    "sil:app": "node e2e/sil-playground.mjs",
    "docs:screenshots": "node e2e/capture-screenshots.mjs"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "idb-keyval": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "serialport": "^13.0.0",
    "uplot": "^1.6.31",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-serial": "^1.0.7",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.2"
  }
}
