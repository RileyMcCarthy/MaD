{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsnode",
    "types": ["node"],
    "strict": true,
    // The test imports @vibes/behaviour, a `file:` link that TS resolves from
    // its target (../../Vibes/bindings/ts); point its vitest peer at this
    // project's copy, as tsconfig.json does, or CI (no Vibes/node_modules)
    // cannot find it.
    "baseUrl": ".",
    "paths": { "vitest": ["./node_modules/vitest"] }
  },
  "include": ["vite.config.ts", "tools/firmwareRelease.ts", "tools/firmwareRelease.test.ts", "src/firmware/release.ts"]
}
