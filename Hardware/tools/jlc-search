#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.9"
# dependencies = ["certifi"]
# ///
"""
jlc-search — reliable JLCPCB / LCSC part search for the MaD project.

Why this exists: circuit-synth's bundled `jlc-fast` (v0.12.1) returns hardcoded
demo data, not live results (see jlc_web_scraper.py: `_get_demo_components`).
This helper hits the tscircuit JLC search mirror, which returns real, structured
JSON (LCSC#, manufacturer part, package, basic/extended, stock, unit price) with
no API key.

Runs via uv's inline-script mode (the shebang) so it carries its own `certifi`
CA bundle — this avoids the macOS python.org "CERTIFICATE_VERIFY_FAILED" stdlib
issue without touching the system Python. `uv` resolves+caches the dep on first
run. (uv is installed via Homebrew.)

Usage:
    jlc-search "STM32G030"                      # general search
    jlc-search "0.1uF 0402" --basic --min-stock 50000
    jlc-search "10k 0402" --sort price          # cheapest first
    jlc-search "USB-C receptacle" --limit 15 --json

Output is a table by default; --json emits the raw filtered records.
The JLCPCB part number is the LCSC number with a leading 'C' (e.g. C52923).
"""
from __future__ import annotations

import argparse
import json
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request

import certifi

API = "https://jlcsearch.tscircuit.com/api/search"
UA = "mad-jlc-search/1.0 (+github.com/MaD)"
_SSL_CTX = ssl.create_default_context(cafile=certifi.where())


def search(query: str, fetch: int) -> list[dict]:
    url = f"{API}?{urllib.parse.urlencode({'q': query, 'limit': fetch})}"
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20, context=_SSL_CTX) as resp:
            payload = json.load(resp)
    except urllib.error.HTTPError as e:
        sys.exit(f"jlc-search: HTTP {e.code} from search backend ({e.reason})")
    except urllib.error.URLError as e:
        sys.exit(f"jlc-search: cannot reach search backend: {e.reason}")
    except json.JSONDecodeError:
        sys.exit("jlc-search: backend returned non-JSON (endpoint may have changed)")
    return payload.get("components", []) or []


def jlcpcb_pn(lcsc) -> str:
    s = str(lcsc).lstrip("Cc")
    return f"C{s}" if s.isdigit() else str(lcsc)


def main() -> int:
    ap = argparse.ArgumentParser(description="Reliable JLCPCB/LCSC part search (live tscircuit backend).")
    ap.add_argument("query", help="search terms, e.g. 'STM32G030' or '0.1uF 0402'")
    ap.add_argument("--limit", type=int, default=10, help="max rows to show (default 10)")
    ap.add_argument("--min-stock", type=int, default=0, help="drop parts below this stock")
    ap.add_argument("--basic", action="store_true", help="only JLCPCB Basic parts (no extended-part fee)")
    ap.add_argument("--sort", choices=("stock", "price"), default="stock",
                    help="sort by stock desc (default) or unit price asc")
    ap.add_argument("--json", action="store_true", help="emit raw filtered JSON records")
    args = ap.parse_args()

    rows = search(args.query, max(args.limit * 5, 50))

    if args.min_stock:
        rows = [r for r in rows if (r.get("stock") or 0) >= args.min_stock]
    if args.basic:
        rows = [r for r in rows if r.get("is_basic")]

    if args.sort == "price":
        rows.sort(key=lambda r: (r.get("price") if r.get("price") is not None else float("inf")))
    else:
        rows.sort(key=lambda r: (r.get("stock") or 0), reverse=True)

    rows = rows[: args.limit]

    if not rows:
        print(f"No JLCPCB parts found for {args.query!r}"
              + (f" (min-stock {args.min_stock}{', basic only' if args.basic else ''})" if args.min_stock or args.basic else ""))
        return 1

    if args.json:
        json.dump([{**r, "jlcpcb_pn": jlcpcb_pn(r.get("lcsc"))} for r in rows], sys.stdout, indent=2)
        print()
        return 0

    hdr = f"{'JLCPCB':<9} {'Type':<6} {'Manufacturer Part':<26} {'Package':<14} {'Stock':>10} {'Unit $':>9}"
    print(hdr)
    print("-" * len(hdr))
    for r in rows:
        price = r.get("price")
        price_s = f"{price:.4f}" if isinstance(price, (int, float)) else "-"
        print(f"{jlcpcb_pn(r.get('lcsc')):<9} "
              f"{'Basic' if r.get('is_basic') else 'Ext':<6} "
              f"{(r.get('mfr') or '')[:26]:<26} "
              f"{(r.get('package') or '')[:14]:<14} "
              f"{(r.get('stock') or 0):>10,} "
              f"{price_s:>9}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
