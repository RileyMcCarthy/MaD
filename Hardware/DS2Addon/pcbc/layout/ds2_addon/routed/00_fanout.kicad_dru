(version 1)
# Generated by pcbc. Do not hand-edit.

(rule "pcbc_geometry_segments"
	(severity warning)
	(constraint track_segment_length (min 0.2mm))
	(condition "A.Type == 'Track'"))

(rule "pcbc_geometry_angles"
	(severity warning)
	(constraint track_angle (min 135))
	(condition "A.Type == 'Track'"))

(rule "width_power"
	(severity warning)
	(constraint track_width (min 0.25mm))
	(condition "A.hasNetclass('Power')"))

(rule "novia_ain0"
	(constraint via_count (max 0))
	(condition "A.NetName == 'AIN0'"))

(rule "novia_ain1"
	(constraint via_count (max 0))
	(condition "A.NetName == 'AIN1'"))

(rule "novia_ain2"
	(constraint via_count (max 0))
	(condition "A.NetName == 'AIN2'"))

(rule "novia_ain3"
	(constraint via_count (max 0))
	(condition "A.NetName == 'AIN3'"))

(rule "novia_refn_f"
	(constraint via_count (max 0))
	(condition "A.NetName == 'REFN_F'"))

(rule "novia_refp_f"
	(constraint via_count (max 0))
	(condition "A.NetName == 'REFP_F'"))

(rule "pads_of_one_footprint"
	(constraint clearance (min 0.1mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference"))

(rule "pcbc_canary"
	(severity warning)
	(constraint length (max 0.001mm))
	(condition "A.NetName == '3V3'"))
