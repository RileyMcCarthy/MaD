@@ -114,9 +114,17 @@ void icount_prepare_for_run(CPUState *cpu, int64_t cpu_budget)
     g_assert(cpu->neg.icount_decr.u16.low == 0);
     g_assert(cpu->icount_extra == 0);
 
-    replay_mutex_lock();
+    {   /* SPIKE 0a-2 ablation: replay mutex (record/replay is off) */
+        static int abl = -1;
+        if (abl < 0) { abl = getenv("QEMU_ABL_REPLAY") ? 1 : 0; }
+        if (!abl) { replay_mutex_lock(); }
+    }
 
-    cpu->icount_budget = MIN(icount_get_limit(), cpu_budget);
+    {   /* SPIKE 0a-2 ablation: icount_get_limit() scans both timer lists */
+        static int abl = -1;
+        if (abl < 0) { abl = getenv("QEMU_ABL_LIMIT") ? 1 : 0; }
+        cpu->icount_budget = abl ? cpu_budget : MIN(icount_get_limit(), cpu_budget);
+    }
     insns_left = MIN(0xffff, cpu->icount_budget);
     cpu->neg.icount_decr.u16.low = insns_left;
     cpu->icount_extra = cpu->icount_budget - insns_left;
@@ -144,7 +152,11 @@ void icount_process_data(CPUState *cpu)
 
     replay_account_executed_instructions();
 
-    replay_mutex_unlock();
+    {   /* SPIKE 0a-2 ablation: pairs with the lock above */
+        static int abl = -1;
+        if (abl < 0) { abl = getenv("QEMU_ABL_REPLAY") ? 1 : 0; }
+        if (!abl) { replay_mutex_unlock(); }
+    }
 }
 
