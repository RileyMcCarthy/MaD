diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 713bdb2..638c117 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -434,6 +434,19 @@ cpu_tb_exec(CPUState *cpu, TranslationBlock *itb, int *tb_exit)
         log_cpu_exec(log_pc(cpu, itb), cpu, itb);
     }
 
+    {   /* SPIKE 0a-2: add K extra W^X toggle PAIRS to measure ns/toggle.
+         * A pair restores the mode, so this cannot break correctness. */
+        static int extra = -1;
+        int q;
+        if (extra < 0) {
+            const char *e = getenv("QEMU_WX_EXTRA");
+            extra = e ? atoi(e) : 0;
+        }
+        for (q = 0; q < extra; q++) {
+            pthread_jit_write_protect_np(false);
+            pthread_jit_write_protect_np(true);
+        }
+    }
     qemu_thread_jit_execute();
     ret = tcg_qemu_tb_exec(cpu_env(cpu), tb_ptr);
     cpu->neg.can_do_io = true;
diff --git a/accel/tcg/tcg-accel-ops-icount.c b/accel/tcg/tcg-accel-ops-icount.c
index d0f7b41..4e14e23 100644
