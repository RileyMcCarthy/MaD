 struct CPUArchState {
+    /* SPIKE 1a: P2-shaped scratch state, so a hijacked instruction can emit
+     * the TCG a real P2 ALU instruction would need and be timed. */
+    uint32_t p2_cog[512];
+    uint32_t p2_c;
+    uint32_t p2_z;
+    uint64_t p2_clocks;
+    uint32_t p2_pc;
+
     target_ulong gpr[32];
     target_ulong gprh[32]; /* 64 top bits of the 128-bit registers */
 
