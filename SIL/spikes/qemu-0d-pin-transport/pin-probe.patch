@@ -123,6 +123,8 @@ DEF_HELPER_2(cbo_zero, void, env, tl)
 
 /* Special functions */
 DEF_HELPER_2(csrr, tl, env, int)
+/* SPIKE: P2 pin-op-shaped probe helper (no TB end) */
+DEF_HELPER_3(p2probe, void, env, tl, tl)
 DEF_HELPER_3(csrw, void, env, int, tl)
