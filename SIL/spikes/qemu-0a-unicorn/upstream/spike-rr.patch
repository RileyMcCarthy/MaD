+        tcg_cpu_exec(cpu);
+        icount_process_data(cpu);
+        bql_lock();
+        ic0 = icount_get_raw();
+        clock_gettime(CLOCK_MONOTONIC, &t0);
+        for (i = 0; i < n; i++) {
