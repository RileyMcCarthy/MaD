{
  "name": "mad-sil-testing",
  "version": "1.0.0",
  "description": "Software-in-the-Loop testing for MaD Control with firmware emulator",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "report": "npx playwright show-report test-results/html",
    "trace": "npx playwright show-trace",
    "build:emulator": "cd emulator && cargo build",
    "build:app": "cd ../Software/MaDControl && npm run build",
    "build": "npm run build:emulator && npm run build:app",
    "clean": "rm -rf test-results build",
    "setup": "npm install"
  },
  "keywords": [
    "testing",
    "sil",
    "playwright",
    "electron"
  ],
  "author": "Riley McCarthy",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.13.10",
    "electron": "^35.0.2",
    "typescript": "^5.8.2"
  }
}

